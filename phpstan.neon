parameters:
    level: 9
    paths:
        - src
        - tests
    # `Phlix\Theming\ThemeSourceInterface` is declared by the HOST server, not by
    # any Composer dependency, so PHPStan cannot find it in `vendor/`. It must be
    # INTRODUCED (scanDirectories), not overridden (stubFiles) — `stubFiles` only
    # replaces the definition of a symbol PHPStan can already resolve, so for a
    # genuinely unfindable symbol it is silently useless.
    scanDirectories:
        - dev-stubs
    # Shape ported verbatim from the family reference
    # phlix-plugin-sample-theme/phpstan.neon on 2026-10-29. Prior config analysed
    # `src` only — 126 lines — leaving the repo's largest, most intricate PHP
    # (tests/SecurityAuditCheckTest.php, a token-stream brace-walker) dark to
    # static analysis, behind two ignoreErrors entries: both "Class ... not
    # found" suppressions for symbols the vendored `detain/phlix-shared` already
    # resolves (and re-declares nothing — `tests/bootstrap.php` loads each dev
    # stub only when the real interface is absent), and `reportUnmatchedIgnoredErrors:
    # false` — the setting that keeps such dead ignores permanent. Omitted here =
    # PHPStan's default true: any future ignore entry that stops matching now
    # surfaces instead of rotting.
    #
    # `excludePaths: vendor` was likewise inert: vendor was never in `paths`.
